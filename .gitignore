# ============================================================
# Python / venv  (由 skills/en-zh-paper-convert/scripts/setup_env.py 一键创建，不入库)
# ============================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.python-version
pip-log.txt

# ============================================================
# 本地工具链二进制  (由 setup_env.py 下载，不入库)
#   tools/tectonic.exe   ~48 MB  LaTeX 引擎
#   tools/tectonic.zip   ~18 MB  原始分发包
# ============================================================
tools/*
!tools/.gitkeep

# 其他可能的本地工具（若用户自行放入）
*.exe
!scripts/*.exe

# ============================================================
# 素材与运行时数据（不入库）
#   Paper/                 待转换论文原件与中文译稿
#   .work/                 中间产物、版式台账、几何 JSON、抽取结果
#   out/                   编译输出成果
#   Temp/                  临时脚本与临时产物
# ============================================================
Paper/
.work/
out/
build/
Temp/

*.aux
*.log
*.out
*.toc
*.synctex.gz

# ============================================================
# 构建残留
# ============================================================
*.tmp.pdf
*-new.pdf

# ============================================================
# 系统 / 编辑器
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# tectonic 缓存回落目录（当用户 AppData 不可写时由 _backend.py 建立）
.tectonic-cache/
.work/**/.tectonic-cache/
